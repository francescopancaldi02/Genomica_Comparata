# 03 GenomeAssembly

```bash
# comando per contig level assembly, crea layout delle reads (struttura della reads)
# wtdbg2 -x rs -g <EXPECTED_GENOMESIZE> -t <NUMBERS_OF_CORES> -i <FASTQ> -fo <OUT_PREFIX> #Default parameters
 wtdbg2 -x rs -g 227054799 -t 9 -i SRR11672506.fastq.gz -fo Anoste_raw #Default parameters

# comando per il consenso, la stringa che descrive l'assembly
# wtpoa-cns -t <NUMBER_OF_CORES> -i <LAYOUT_FILE-.ctg.lay.gz> -fo <OUT_PREFIX>
wtpoa-cns -t 9 -i Anoste_raw.ctg.lay.gz -fo Anoste_raw.fasta

# comandi per analisi busco
coda activate sequence
# export NUMEXPR_MAX_THREADS=<CPU_number>
# busco -m <MODE> -l <LINEAGE> -c <CPU_NUMBER> -o <OUTPUT_NAME> -i <INPUT>
busco -m geno -l $BUSCO/diptera_odb12 -c 8 -o Anoste_raw -i Anoste_raw.fasta

# comandi per genome polishing
# mapping delle reads (dove cadono nei contig)
# mapping short and long reads on assembly
minimap2 -ax <PRESET_Options> --MD -t <cores_number> <target.fa> <fastq1> <fastq2> > <SAM_FILE>
# trasforma file SAM in BAM
samtools view -b <SAM FILE> > <BAM FILE>
# rimuove file SAM
rm <SAM FILE>
# sorta il BAM e lo indicizza
samtools sort -@<NUM_THREADS> -o <OUT_FILE> <INFILE>
samtools index <INFILE>

[ #script
#!/bin/bash


CPU=$1
INPUT=$2
SR_1=$3
SR_2=$4
PREFIX=$5
LR=$6

#MAPPING SHORT READS ON ASSEMBLY
minimap2 -ax sr --MD -t "$CPU" "$INPUT" "$SR_1" "$SR_2" > "$PREFIX"_sr.sam

#trasforma file SAM in BAM
samtools view -b "$PREFIX"_sr.sam > "$PREFIX"_sr.bam
#rimuove file SAM
rm "$PREFIX"_sr.sam

#sorta il BAM e lo indicizza
samtools sort -@"$CPU" -o "$PREFIX"_sr_sorted.bam "$PREFIX"_sr.bam
samtools index "$PREFIX"_sr_sorted.bam

#MAPPING LONG READS ON ASSEMBLY
minimap2 -ax map-pb --MD -t "$CPU" "$INPUT" "LR" > "$PREFIX"_lr.sam

#trasforma file SAM in BAM
samtools view -b "$PREFIX"_lr.sam > "$PREFIX"_lr.bam
#rimuove file SAM
rm "$PREFIX"_lr.sam

#sorta il BAM e lo indicizza
samtools sort -@"$CPU" -o "$PREFIX"_lr_sorted.bam "$PREFIX"_lr.bam
samtools index "$PREFIX"_lr_sorted.bam


]



```


